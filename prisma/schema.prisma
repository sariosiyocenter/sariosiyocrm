// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Student {
  id         Int       @id @default(autoincrement())
  name       String
  phone      String
  birthDate  String
  address    String
  location   String?
  status     String    @default("Faol")
  joinedDate String
  balance    Float     @default(0)
  photo      String?
  comment    String?
  rating     Float?
  telegramId String?   @unique
  fatherTelegramId String?
  motherTelegramId String?
  fatherName  String?
  fatherPhone String?
  motherName  String?
  motherPhone String?

  // Privilege fields
  privilegeType String    @default("None")
  certCategory  String?
  certSubject   String?
  certType      String?
  certScore     String?
  customPrices  Json?     @default("{}")
  certificates  Json?     @default("[]")

  gender          String?   @default("Erkak")

  // New fields for reports
  statusChangedAt DateTime? @default(now())
  leaveReason     String?

  // Transportda qatnaydimi. Avtomatik rejalashtirish shu belgiga qarab
  // o'quvchini mashinalarga taqsimlaydi.
  needsTransport Boolean @default(false)

  // Transport Relation
  transportId Int?
  transport   Transport? @relation(fields: [transportId], references: [id])

  // Student's actual school (maktab)
  studentSchool String?
  orgType       String?
  region        String?
  district      String?

  // Nima maqsadda o'qiyapti: "Asosiy fan" (yo'nalishning asosiy fani),
  // "Majburiy fan" (blok imtihonining majburiy fani) yoki "Mustaqil"
  // (kirish imtihoniga bog'liq emas, o'zi uchun).
  studyGoal     String?
  // Qaysi yo'nalishga tayyorlanmoqda (masalan "Iqtisodiyot").
  directionId   Int?
  direction     Direction? @relation(fields: [directionId], references: [id])

  // Relations
  schoolId   Int
  school     School    @relation(fields: [schoolId], references: [id])
  groups     Group[]   @relation("StudentGroups")
  payments   Payment[]
  attendances Attendance[]
  scores      Score[]
  deliveryLogs DeliveryLog[]
  routeStops  RouteStop[]
  examResults ExamResult[]
  faceProfile FaceProfile?
  paymeOrders PaymeOrder[]

  @@index([schoolId])
}

model Transport {
  id          Int      @id @default(autoincrement())
  name        String   // e.g., "Avtobus #1"
  model       String?  // e.g., "Mercedes Sprinter"
  number      String?  // Plate number
  capacity    Int
  driverName  String?
  driverPhone String?
  status      String   @default("Faol") // Faol, Ta'mirda, Arxiv
  
  driverId    Int?     @unique
  driver      User?    @relation("DriverTransport", fields: [driverId], references: [id])
  
  schoolId    Int
  school      School   @relation(fields: [schoolId], references: [id])
  students    Student[]
  deliveryLogs DeliveryLog[]
  routes      Route[]
  routeRuns   RouteRun[]

  @@index([schoolId])
}

model DeliveryLog {
  id          Int      @id @default(autoincrement())
  // Mashina reysdan ham kelishi mumkin, shuning uchun ixtiyoriy.
  transportId Int?
  transport   Transport? @relation(fields: [transportId], references: [id])
  studentId   Int
  student     Student   @relation(fields: [studentId], references: [id])
  date        String
  status      String    // Olib ketildi, Uyiga yetkazildi, Kelmadi

  // Qaysi reysga tegishli. Ilgari yozuv faqat (o'quvchi, sana) bilan
  // topilardi va ertalabki holat kechqurun ustidan yozilib ketardi.
  runId       Int?
  run         RouteRun? @relation(fields: [runId], references: [id], onDelete: Cascade)

  // Kim va qachon belgiladi (haydovchi botdan yoki admin sahifadan).
  markedById  Int?
  markedBy    User?     @relation("DeliveryMarker", fields: [markedById], references: [id])
  markedAt    DateTime  @default(now())
  note        String?

  schoolId    Int
  school      School    @relation(fields: [schoolId], references: [id])

  @@unique([runId, studentId])
  @@index([schoolId])
  @@index([schoolId, date])
}

model Expense {
  id          Int      @id @default(autoincrement())
  amount      Float
  category    String   // Ish haqi, Ijara, Kommunal, Marketing, Boshqa
  date        String
  description String?
  // Pul qayerdan chiqqani: Naqd (kassadan) yoki Karta / O'tkazma (bankdan).
  // Kassadagi naqd qoldiq faqat "Naqd" chiqimlarni hisobga oladi.
  method      String   @default("Naqd")
  
  schoolId    Int
  school      School   @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
}

model Teacher {
  id              Int       @id @default(autoincrement())
  name            String
  phone           String
  // Eskirgan maosh maydonlari. Oylik xodim kartasidan (User.salary,
  // User.kpiPercent) va guruhga belgilangan haqdan (Group.payType/payValue)
  // hisoblanadi. Bular faqat eski kod uchun qoldi va User dan nusxa qilib
  // turiladi — ikki xil raqam paydo bo'lmasligi uchun.
  salary          Float
  sharePercentage Float
  lessonFee       Float     @default(0)
  salaryType      String    @default("FIXED") // FIXED, KPI, FIXED_KPI
  birthDate       String
  hiredDate       String
  photo           String?
  status          String    @default("Faol")
  telegramId      String?   @unique

  // Ustoz yozuvi va xodim yozuvi bitta odam. Ilgari ular faqat ism bo'yicha
  // topilardi: ismi o'zgargan yoki xodim yozuvi umuman yo'q ustoz "eski" ustoz
  // bo'lib qolar, unga alohida (kambag'al) profil ochilardi va oylik ham,
  // davomat ham, Telegram xabari ham ishlamasdi. Endi bog'lanish shu maydonda.
  userId          Int?      @unique
  user            User?     @relation("TeacherAccount", fields: [userId], references: [id])

  schoolId        Int
  school          School    @relation(fields: [schoolId], references: [id])
  groups          Group[]
  teacherAttendances TeacherAttendance[]

  @@index([schoolId])
}

model TeacherAttendance {
  id        Int      @id @default(autoincrement())
  teacherId Int
  teacher   Teacher  @relation(fields: [teacherId], references: [id])
  date      String
  status    String   // Keldi, Kelmapdi, Sababli
  
  schoolId  Int
  school    School   @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
}

model Group {
  id         Int       @id @default(autoincrement())
  name       String
  teacherId  Int
  teacher    Teacher   @relation(fields: [teacherId], references: [id])
  courseId   Int
  course     Course    @relation(fields: [courseId], references: [id])
  schedule   String
  days       String
  room       Int?
  roomRel    Room?     @relation(fields: [room], references: [id])

  syllabusId Int?
  syllabus   Syllabus? @relation(fields: [syllabusId], references: [id])

  // Ustozga shu guruh uchun qanday haq to'lanadi:
  //   null          - xodim kartasidagi umumiy KPI foizi (guruhga tushgan puldan)
  //   'Belgilangan' - payValue: oyiga belgilangan summa (masalan 2 000 000)
  //   'Foiz'        - payValue: shu guruhga tushgan puldan foiz
  // Har guruhga alohida qo'yish mumkin: bir guruh 2 mln, ikkinchisi 3 mln.
  payType    String?
  payValue   Float     @default(0)

  schoolId   Int
  school     School    @relation(fields: [schoolId], references: [id])
  students   Student[] @relation("StudentGroups")
  attendances Attendance[]
  scores      Score[]
  payments    Payment[]
  examAssignments ExamAssignment[]

  @@index([schoolId])
}

model Lead {
  id            Int      @id @default(autoincrement())
  name          String
  phone         String
  course        String
  source        String
  status        String   @default("Yangi")
  createdAt     DateTime @default(now())

  // Additional profile fields from registration
  birthDate     String?
  address       String?
  studentSchool String?
  orgType       String?
  region        String?
  district      String?
  fatherName    String?
  fatherPhone   String?
  motherName    String?
  motherPhone   String?
  preferredTime String?
  notes         String?
  photo         String?

  // Privilege fields
  privilegeType String    @default("None")
  certCategory  String?
  certSubject   String?
  certType      String?
  certificates  Json?     @default("[]")

  studyGoal     String?
  directionId   Int?

  schoolId      Int
  school        School   @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
}

model Payment {
  id          Int      @id @default(autoincrement())
  studentId   Int
  student     Student  @relation(fields: [studentId], references: [id])
  amount      Float
  type        String
  date        String
  description String

  // Qaysi kurs uchun to'langani. Ixtiyoriy: eski to'lovlarda va bir nechta
  // kursga taalluqli umumiy to'lovlarda bo'sh qoladi.
  courseId    Int?
  course      Course?  @relation(fields: [courseId], references: [id])

  // Qaysi guruhga tegishli. Oylik hisob, guruhlar orasida ko'chirish va pul
  // qaytarish yozuvlari shu maydon orqali guruhga (demak ustozga ham)
  // bog'lanadi. Ilgari guruh faqat izoh matnida turardi, shuning uchun qaysi
  // pul qaysi guruhniki ekanini aniqlab bo'lmasdi.
  groupId     Int?
  group       Group?   @relation(fields: [groupId], references: [id])

  schoolId    Int
  school      School   @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@index([courseId])
  @@index([groupId])
}

model Course {
  id         Int       @id @default(autoincrement())
  name       String
  price      Float
  
  syllabusId Int?
  syllabus   Syllabus? @relation(fields: [syllabusId], references: [id])
  
  schoolId   Int
  school     School    @relation(fields: [schoolId], references: [id])
  groups     Group[]
  payments   Payment[]

  @@index([schoolId])
}

model Room {
  id       Int    @id @default(autoincrement())
  name     String
  capacity Int

  schoolId Int
  school   School  @relation(fields: [schoolId], references: [id])
  groups   Group[]

  @@index([schoolId])
}

model Organization {
  id        Int      @id @default(autoincrement())
  name      String
  address   String?
  phone     String?
  createdAt DateTime @default(now())
  schools   School[]

  status     String    @default("Sinov") // Sinov, Faol, Muzlatilgan
  expiresAt  DateTime?
  maxSchools Int       @default(3)
}

model School {
  id      Int    @id @default(autoincrement())
  name    String
  address String?

  organizationId Int?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  students Student[]
  teachers Teacher[]
  groups   Group[]
  leads    Lead[]
  payments Payment[]
  courses  Course[]
  rooms    Room[]
  users    User[]
  settings Setting[]
  attendances Attendance[]
  scores      Score[]
  teacherAttendances TeacherAttendance[]
  expenses    Expense[]
  transports  Transport[]
  deliveryLogs DeliveryLog[]
  routes      Route[]
  routeRuns   RouteRun[]
  smsLogs     SmsLog[]
  questions   Question[]
  exams       Exam[]
  examResults ExamResult[]
  examAssignments ExamAssignment[]
  applyTokens      ApplyToken[]
  staffAttendances StaffAttendance[]
  salaryPayments   SalaryPayment[]
  topics           Topic[]
  syllabuses       Syllabus[]
  messageTemplates MessageTemplate[]
  messageCampaigns MessageCampaign[]
  autoMessageRules AutoMessageRule[]
  cashHandovers    CashHandover[]
  cashDayCloses    CashDayClose[]
  faceProfiles     FaceProfile[]
  directions       Direction[]
  driverAvailability DriverAvailability[]
  paymeOrders      PaymeOrder[]
  paymeTransactions PaymeTransaction[]
}

model SmsLog {
  id        Int      @id @default(autoincrement())
  toPhone   String
  toName    String?
  message   String
  status    String   @default("PENDING") // SENT, FAILED, PENDING
  type      String   // ATTENDANCE, PAYMENT, PAYMENT_CONFIRM, SCORE, BIRTHDAY
  studentId Int?
  eskizId   String?
  errorMsg  String?
  channel   String   @default("SMS") // SMS | TELEGRAM
  campaignId Int?
  sentAt    DateTime @default(now())

  schoolId  Int
  school    School   @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
}

model MessageTemplate {
  id            Int      @id @default(autoincrement())
  name          String
  body          String
  category      String   @default("Umumiy") // Qarzdorlik | Tug'ilgan kun | Eslatma | Umumiy
  isAuto        Boolean  @default(false)
  autoType      String?  // BIRTHDAY | DEBT_REMINDER
  autoChannel   String   @default("BOTH")   // SMS | TELEGRAM | BOTH
  autoRecipient String   @default("PARENT") // PARENT | STUDENT
  autoConfig    Json?
  autoTime      String?  @default("09:00")  // e.g. "09:00"
  lastRunDate   String?

  // Eskiz moderatsiyasi. SMS matni operator tomonidan tasdiqlanmaguncha
  // yuborilmaydi, shuning uchun shablon yaratilishi bilan Eskizga jo'natiladi.
  //   moderation | confirmed | rejected | service | xato matni
  eskizStatus     String?
  eskizTemplateId String?
  schoolId      Int
  school        School   @relation(fields: [schoolId], references: [id])
  createdAt     DateTime @default(now())

  @@index([schoolId])
}

model MessageCampaign {
  id          Int      @id @default(autoincrement())
  message     String
  channel     String   // SMS | TELEGRAM | BOTH
  recipientTo String   // PARENT | STUDENT
  filtersJson Json?
  totalCount  Int      @default(0)
  sentCount   Int      @default(0)
  failedCount Int      @default(0)
  schoolId    Int
  school      School   @relation(fields: [schoolId], references: [id])
  createdAt   DateTime @default(now())

  @@index([schoolId])
}

model AutoMessageRule {
  id            Int      @id @default(autoincrement())
  name          String   @default("Avtomatik qoida")
  type          String   // BIRTHDAY | DEBT_REMINDER
  enabled       Boolean  @default(false)
  body          String   @db.Text
  channel       String   @default("BOTH")   // SMS | TELEGRAM | BOTH
  recipientTo   String   @default("PARENT") // PARENT | STUDENT
  config        Json?
  time          String   @default("09:00")  // e.g. "09:00"
  lastRunDate   String?
  schoolId      Int
  school        School   @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
}

model Attendance {
  id        Int      @id @default(autoincrement())
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id])
  groupId   Int
  group     Group    @relation(fields: [groupId], references: [id])
  date      String
  status    String   // Keldi, Kelmapdi, Sababli

  // Topic tracking
  topicId   Int?
  topic     Topic?   @relation(fields: [topicId], references: [id])
  caughtUp  Boolean  @default(false)
  
  schoolId  Int
  school    School   @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  // Attendance is the largest table and is always read by one of these three shapes:
  // the recent window at startup, one group's grid, or one student's history.
  @@index([schoolId, date])
  @@index([groupId, date])
  @@index([studentId])
}

model Topic {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  order       Int      @default(1)

  // O'quv reja tuzilmasi. Hammasi ixtiyoriy: moduli yo'q eski mavzular
  // interfeysda "1-modul" ostida ko'rinadi, ma'lumot yo'qolmaydi.
  moduleName  String?  // masalan "Tenglama va tengsizliklar"
  hours       Int?     // akademik soat
  materials   String?  // "PDF,Video,Test" ko'rinishidagi belgilar ro'yxati
  status      String?  // Rejada | Jarayonda | Tugallangan

  syllabusId  Int?
  syllabus    Syllabus? @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  schoolId    Int
  school      School   @relation(fields: [schoolId], references: [id])
  attendances Attendance[]

  @@index([schoolId])
  @@index([syllabusId])
}

model Syllabus {
  id          Int      @id @default(autoincrement())
  name        String
  materials   String?  // Uchebniy posobiyalar (text or list of materials)
  schoolId    Int
  school      School   @relation(fields: [schoolId], references: [id])
  groups      Group[]
  topics      Topic[]
  courses     Course[]

  @@index([schoolId])
}

model Score {
  id        Int      @id @default(autoincrement())
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id])
  groupId   Int
  group     Group    @relation(fields: [groupId], references: [id])
  date      String
  value     Float
  comment   String?
  
  schoolId  Int
  school    School   @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
}

model Setting {
  id               Int      @id @default(autoincrement())
  schoolId         Int      @unique
  school           School   @relation(fields: [schoolId], references: [id])
  orgName          String   @default("SARIOSIYO")
  logo             String?
  adminPhone       String?
  address          String?
  // O'quv markazi binosining koordinatasi ("kenglik,uzunlik"). Admin uni
  // Sozlamalardan xaritada bir marta belgilaydi; o'quvchi joylashuvi shu
  // nuqtaga nisbatan ko'rsatiladi.
  centerLocation   String?

  // Transport xabarlari: haydovchi o'quvchini olganda yoki uyiga
  // yetkazganda ota-onaga darhol xabar ketadimi. Ota-onaga haqiqiy xabar
  // ketishi uchun ataylab o'chiq holda keladi — admin o'zi yoqadi.
  transportNotify  Boolean  @default(false)
  // TELEGRAM | SMS | BOTH. SMS pullik, shuning uchun sukut bo'yicha Telegram.
  transportChannel String   @default("TELEGRAM")
  telegram         String?
  // Telegram webhook siri (setWebhook secret_token). Har update sarlavhasi
  // shu bilan solishtiriladi; brauzerga qaytarilmaydi.
  telegramWebhookSecret String?
  instagram        String?
  workingHours     String?
  eskizEmail       String?
  eskizPassword    String?
  eskizFrom        String?

  // Payme (Merchant API). Kalitlar SETTINGS_KEY bilan shifrlanadi va
  // brauzerga hech qachon qaytarilmaydi — adminga ham faqat "o'rnatilgan"
  // belgisi ko'rinadi. `paymeMode`: off | test | live. Test rejimda faqat
  // test kaliti qabul qilinadi va havolalar sandbox kassaga olib boradi.
  paymeMerchantId    String?
  paymeKey           String?
  paymeTestKey       String?
  paymeMode          String   @default("off")
  // Webhook manzilining maxfiy qismi: /api/payme/<token>. Tasodifiy (192 bit),
  // taxmin qilib bo'lmaydi; almashtirilsa Payme kabinetida ham yangilanadi.
  // @unique emas — Vercel'dagi `prisma db push` unique qo'shishda "data loss"
  // ogohlantirishi bilan to'xtab qolardi; indeks yetarli.
  paymeEndpointToken String?
  // Payme o'tgan to'lovni bekor qilmoqchi bo'lsa (chargeback) rozimizmi.
  // Rozi bo'lsak manfiy "Qaytarish" yozuvi yoziladi, bo'lmasak -31007.
  paymeAllowRefund   Boolean  @default(true)
  // Jonli rejimda so'rov faqat Payme IP manzillaridan qabul qilinadi.
  paymeIpCheck       Boolean  @default(true)
  // Fiskal chek uchun IKPU (MXIK) kodi — to'ldirilsa CheckPerformTransaction
  // javobiga `detail` qo'shiladi.
  paymeMxik          String?
  paymePackageCode   String?
  paymeVatPercent    Int      @default(0)

  @@index([paymeEndpointToken])
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  phone     String?
  photo     String?
  position  String?
  salary    Int?     @default(0)
  role      UserRole @default(RECEPTIONIST)
  createdAt DateTime @default(now())
  telegramId String?   @unique

  // Faol | Arxiv. Davomat yoki oylik yozuvi bor xodimni o'chirib bo'lmaydi
  // (ikkala bog'lanish ham Restrict), shuning uchun uni arxivga olamiz:
  // ro'yxatdan yo'qoladi, tarix esa buzilmaydi.
  status    String   @default("Faol")

  schoolId  Int?
  school    School?  @relation(fields: [schoolId], references: [id])

  workDays   String?
  kpiPercent Int     @default(0)

  driverTransport  Transport?       @relation("DriverTransport")
  driverRoutes     Route[]          @relation("DriverRoutes")
  driverRuns       RouteRun[]       @relation("DriverRuns")
  driverAvailability DriverAvailability[] @relation("DriverAvailability")
  markedDeliveries DeliveryLog[]    @relation("DeliveryMarker")
  sellerLeads      SaaSLead[]       @relation("SellerLeads")
  staffAttendances StaffAttendance[]
  salaryPayments   SalaryPayment[]
  teacherProfile   Teacher?         @relation("TeacherAccount")

  @@index([schoolId])
}

model SalaryPayment {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  month      String   // "2026-06"
  amount     Int
  baseSalary Int
  bonuses    Int      @default(0)
  fines      Int      @default(0)
  note       String?
  paidAt     DateTime @default(now())
  expenseId  Int?
  schoolId   Int
  school     School   @relation(fields: [schoolId], references: [id])

  @@unique([userId, month])
  @@index([schoolId])
  @@index([userId])
}

model StaffAttendance {
  id       Int    @id @default(autoincrement())
  userId   Int
  user     User   @relation(fields: [userId], references: [id])
  date     String
  status   String
  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])

  @@unique([userId, date])
  @@index([schoolId])
  @@index([userId])
}

enum UserRole {
  ADMIN
  MANAGER
  TEACHER
  SUPPORT_TEACHER
  RECEPTIONIST
  DRIVER
  TECH_STAFF
  SELLER
}

model Route {
  id          Int      @id @default(autoincrement())
  name        String
  startTime   String?   // e.g., "08:00"
  transportId Int?
  transport   Transport? @relation(fields: [transportId], references: [id])
  driverId    Int?
  driver      User?    @relation("DriverRoutes", fields: [driverId], references: [id])
  days        String   // TOQ, JUFT, HAR_KUNI

  // Darsdan keyin uyga (QAYTISH) yoki ertalab uydan markazga (KETISH).
  // Asosiy ish — uyga tarqatish: markazga o'quvchilar o'zi keladi, kechqurun
  // esa taksi topilmaydi. Shuning uchun sukut bo'yicha QAYTISH.
  direction   String   @default("QAYTISH")

  // Bekatlar tartibini tizim o'zi quradi (masofa bo'yicha). Admin qo'lda
  // sursa false bo'ladi va tizim endi aralashmaydi.
  autoOrder   Boolean  @default(true)

  // Avtomatik rejalashtirish yaratgan marshrut: qayta rejalashtirilganda
  // shular yangilanadi, qo'lda tuzilganlariga tegilmaydi.
  autoPlanned Boolean  @default(false)

  // Kunlik reja marshruti aynan shu kunga tegishli ("YYYY-MM-DD"). Har kuni
  // qaytadan hisoblanadi, chunki yo'lovchilar har kuni boshqacha: kim darsga
  // kelgan, kim transportga yozilgan. null bo'lsa — takrorlanuvchi marshrut
  // (qo'lda tuzilgan), `days` bo'yicha ishlaydi.
  date        String?

  // Qaysi to'lqinga (dars tugash vaqtiga) tegishli. `startTime` bilan bir xil
  // emas: ikkinchi reys kechroq chiqadi (21:00 to'lqini, 22:18 da chiqish).
  // Shu maydonsiz qayta rejalashtirishda ikkinchi reys topilmay, har safar
  // yangi marshrut yaratilardi.
  tolqin      String?
  // Shu mashinaning nechanchi reysi (bir mashina bir necha marta qatnasa).
  navbat      Int      @default(1)

  // Bekatlar. Ilgari bu `studentIds Int[]` edi — o'chirilgan o'quvchi ham
  // ro'yxatda qolib ketardi va sanoq yolg'on chiqardi. Ustun hozircha
  // saqlanib turibdi (endi o'qilmaydi), keyingi bosqichda olib tashlanadi.
  studentIds  Int[]
  stops       RouteStop[]
  runs        RouteRun[]

  schoolId    Int
  school      School   @relation(fields: [schoolId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([schoolId])
}

/// Marshrutdagi bitta bekat: qaysi o'quvchi, nechanchi bo'lib.
///
/// O'quvchi o'chirilsa bekat ham ketadi (Cascade) — shuning uchun "ro'yxatda
/// bor, lekin bazada yo'q" holati boshqa bo'lmaydi.
model RouteStop {
  id        Int      @id @default(autoincrement())
  routeId   Int
  route     Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tartib    Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([routeId, studentId])
  @@index([routeId])
}

/// Haydovchining kunlik javobi: bugun shu to'lqinda qatnasha oladimi.
///
/// Dars tugashidan ~2 soat oldin bot so'raydi. Reja faqat "HA" deganlardan
/// tuziladi — javob bermaganlar adminning ro'yxatida qoladi, u qo'ng'iroq
/// qiladi. Har (haydovchi, sana, to'lqin) uchun bitta yozuv.
model DriverAvailability {
  id         Int      @id @default(autoincrement())
  driverId   Int
  driver     User     @relation("DriverAvailability", fields: [driverId], references: [id], onDelete: Cascade)
  date       String   // "YYYY-MM-DD"
  endTime    String   // to'lqin vaqti, "21:00"
  status     String   @default("KUTILMOQDA") // KUTILMOQDA | HA | YOQ
  askedAt    DateTime @default(now())
  answeredAt DateTime?
  izoh       String?

  schoolId   Int
  school     School   @relation(fields: [schoolId], references: [id])

  @@unique([driverId, date, endTime])
  @@index([schoolId, date])
}

/// Bir kunning bir reysi: shu marshrut, shu sana.
///
/// Yetkazish yozuvlari shunga bog'lanadi, shuning uchun ertalabki "olib
/// ketildi" kechqurungi "uyiga yetkazildi" ni bosib ketmaydi. startedAt /
/// finishedAt — haydovchi botda "boshladim" va "tugatdim" bosgan vaqt.
model RouteRun {
  id          Int      @id @default(autoincrement())
  routeId     Int
  route       Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  date        String   // "YYYY-MM-DD", mahalliy vaqt bo'yicha
  driverId    Int?
  driver      User?    @relation("DriverRuns", fields: [driverId], references: [id])
  transportId Int?
  transport   Transport? @relation(fields: [transportId], references: [id])
  startedAt   DateTime?
  finishedAt  DateTime?

  schoolId    Int
  school      School   @relation(fields: [schoolId], references: [id])
  createdAt   DateTime @default(now())

  deliveryLogs DeliveryLog[]

  @@unique([routeId, date])
  @@index([schoolId, date])
}

model Question {
  id            Int      @id @default(autoincrement())
  text          String
  imageUrl      String?
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String   // 'A' | 'B' | 'C' | 'D'
  difficulty    Int      @default(1)
  subject       String
  topic         String

  schoolId      Int
  school        School   @relation(fields: [schoolId], references: [id])

  @@index([schoolId, subject, topic])
}

model Exam {
  id             Int      @id @default(autoincrement())
  name           String
  date           String
  duration       Int
  status         String   @default("Yaqinlashmoqda")
  blocks         Json     // ExamBlock[] — always read as whole, no per-field queries needed
  totalQuestions Int      @default(0)
  maxScore       Float    @default(0)
  variants       Json?    // Variant[] — generated and stored here
  createdAt      DateTime @default(now())

  schoolId       Int
  school         School   @relation(fields: [schoolId], references: [id])
  results        ExamResult[]
  assignments    ExamAssignment[]

  @@index([schoolId])
}

model ExamAssignment {
  id       Int   @id @default(autoincrement())
  examId   Int
  exam     Exam  @relation(fields: [examId], references: [id], onDelete: Cascade)
  groupId  Int
  group    Group @relation(fields: [groupId], references: [id])
  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])

  @@unique([examId, groupId])
}

model ExamResult {
  id          Int      @id @default(autoincrement())
  studentId   Int
  student     Student  @relation(fields: [studentId], references: [id])
  examId      Int
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  variantCode String?
  answers     Json?    // Record<number, 'A'|'B'|'C'|'D'|null>
  score       Float    @default(0)
  percentage  Float    @default(0)
  blockScores Json?    // {subject: string, earned: number, max: number}[]
  scannedAt   DateTime @default(now())

  schoolId    Int
  school      School   @relation(fields: [schoolId], references: [id])

  @@unique([studentId, examId])
  @@index([examId, schoolId])
}

// One row per (school, month) that monthly billing has been started for.
// The unique constraint is the lock: two requests arriving at the same time race to
// insert, one wins, and the loser skips billing instead of charging everyone twice.
model BillingRun {
  id        Int      @id @default(autoincrement())
  schoolId  Int
  month     String   // "2026-09"
  createdAt DateTime @default(now())

  @@unique([schoolId, month])
  @@index([schoolId])
}

model SaaSLead {
  id          Int      @id @default(autoincrement())
  name        String
  phone       String
  centerName  String?
  status      String   @default("Yangi") // Yangi, Bog'lanildi, Sotildi, Rad etildi
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  sellerId    Int?
  seller      User?    @relation("SellerLeads", fields: [sellerId], references: [id])
}

model ApplyToken {
  id        String   @id @default(uuid())
  schoolId  Int
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Kassa: naqd pulni bankka yoki rahbarga topshirish (inkassatsiya).
// Kassadagi naqd = naqd kirim − naqd chiqim − inkassatsiya.
model CashHandover {
  id          Int      @id @default(autoincrement())
  amount      Float
  date        String   // "2026-09-07"
  toWhom      String   // "Bank", "Rahbar" yoki ism
  note        String?
  createdById Int?
  createdAt   DateTime @default(now())

  schoolId    Int
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, date])
}

// Kassa: kunni yopish. Administrator kassadagi naqd pulni sanaydi, tizim
// kutilgan summani biladi — farq shu yerda qoladi.
model CashDayClose {
  id          Int      @id @default(autoincrement())
  date        String   // "2026-09-07"
  expected    Float    // tizim bo'yicha kun oxirida bo'lishi kerak bo'lgan naqd
  counted     Float    // qo'lda sanalgan
  note        String?
  closedById  Int?
  createdAt   DateTime @default(now())

  schoolId    Int
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, date])
}

// Face ID yuz belgisi (128 ta son).
//
// Alohida jadvalda turadi, chunki /api/init hamma o'quvchini to'liq yuboradi:
// 235 ta belgi qo'shilsa javob ~0.5 MB ga og'irlashardi (Vercel chegarasi
// 4.5 MB). Belgilar faqat Face ID yo'qlamasi ochilganda, o'sha guruh uchun
// yuklanadi.
model FaceProfile {
  id         Int      @id @default(autoincrement())
  studentId  Int      @unique
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  descriptor Json     // 128 ta son
  source     String   @default("kamera")  // "kamera" | "rasm" — qayerdan olingani
  updatedAt  DateTime @default(now()) @updatedAt

  schoolId   Int
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

// O'qish yo'nalishi: "Iqtisodiyot (Matematika + Ingliz tili)".
//
// Admin sozlamalardan o'zi qo'shadi — ro'yxat markazdan markazga farq qiladi.
// `subjects` shunchaki ko'rsatiladigan matn: qaysi fanlar juftligi ekani
// o'quvchini yozayotgan xodimga ham, ariza beruvchiga ham shu yerda ko'rinadi.
model Direction {
  id        Int      @id @default(autoincrement())
  name      String
  subjects  String?
  createdAt DateTime @default(now())

  schoolId  Int
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students  Student[]

  @@index([schoolId])
}

// ---------------------------------------------------------------------------
// Payme (Merchant API).
//
// Pul kursga biriktiriladi (lib/allocation.js), shuning uchun buyurtma ham
// o'quvchi + guruh + summa bilan yaratiladi. Payme'ga faqat buyurtmaning
// tasodifiy ID si va summa ketadi — ism, telefon ketmaydi. Summani Payme
// tomonida o'zgartirib bo'lmaydi: CheckPerformTransaction buyurtmadagi
// summa bilan tiyinigacha solishtiradi.
// ---------------------------------------------------------------------------

// Bizning tomonimizda yaratilgan "to'lov niyati". ID — 16 belgili tasodifiy
// token (Payme "account.order_id"). Ketma-ket raqam emas: o'quvchi ID sini
// ham, buyurtmalar sonini ham oshkor qilmaydi.
model PaymeOrder {
  id          String   @id
  studentId   Int
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  groupId     Int?
  courseId    Int?
  amount      Int      // so'm (butun). Payme bilan tiyinda (x100) solishtiriladi.
  status      String   @default("new")  // new | paid | refunded | cancelled
  source      String   @default("crm")  // crm | bot
  createdById Int?     // havolani yaratgan xodim (User.id); bot orqali bo'lsa null
  chatId      String?  // bot orqali yaratilgan bo'lsa — kimga natijani yozish
  test        Boolean  @default(false)  // test rejimda yaratilgan (pul haqiqiy emas)
  paymentId   Int?     @unique          // to'lov o'tganda yozilgan Payment qatori
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schoolId    Int
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  transactions PaymeTransaction[]

  @@index([schoolId, studentId])
  @@index([schoolId, createdAt])
}

// Payme tranzaksiyasi (protokoldagi holat mashinasi):
//   1 — yaratildi, 2 — o'tkazildi, -1 — o'tkazilmay bekor, -2 — o'tgach bekor.
// `paymeId` unique: bir xil so'rov ikki marta kelsa (Payme qayta yuboradi)
// ikkinchi yozuv yaratilmaydi. Holat o'tishlari `updateMany WHERE state = ?`
// bilan atomar — parallel PerformTransaction ikki marta kreditlay olmaydi.
model PaymeTransaction {
  id          Int      @id @default(autoincrement())
  paymeId     String   @unique
  orderId     String
  order       PaymeOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount      Int      // so'm
  state       Int
  reason      Int?
  paymeTime   BigInt   // Payme yuborgan `time` (ms) — 12 soatlik taymaut shundan
  createTime  BigInt
  performTime BigInt   @default(0)
  cancelTime  BigInt   @default(0)
  paymentId   Int?     // Payment (Peyme) qatori
  refundPaymentId Int? // Payment (Qaytarish) qatori — state -2 da
  // SetFiscalData orqali kelgan fiskal chek (GNK): oplata va bekor alohida.
  fiscalPerform Json?
  fiscalCancel  Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schoolId    Int
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([schoolId, createTime])
  @@index([schoolId, paymeTime])
}

// Har bir Payme so'rovining izi (audit). Authorization sarlavhasi
// yozilmaydi. School o'chirilsa ham qoladi — bu moliyaviy jurnal.
model PaymeLog {
  id         Int      @id @default(autoincrement())
  schoolId   Int?
  method     String?
  paymeId    String?
  orderId    String?
  ip         String?
  ok         Boolean
  errorCode  Int?
  request    Json?
  response   Json?
  durationMs Int?
  createdAt  DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([paymeId])
}
